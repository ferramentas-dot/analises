# Cloudflare API token (Pages Read + Pages Write)
# Como gerar: https://dash.cloudflare.com/profile/api-tokens > Create Token
# Permissões mínimas: Account > Cloudflare Pages: Edit
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_API_TOKEN_ID=

# GitHub Personal Access Token
# Como gerar (fine-grained, recomendado): https://github.com/settings/personal-access-tokens/new
# Repo access: só ferramentas-dot/analises
# Permissões: Contents: Read and write, Metadata: Read
GITHUB_TOKEN=
